{
  "api": "POST /api/global_config/config/reset-default",
  "cases": [
    {
      "name": "恢复默认配置 成功",
      "kind": "http",
      "actor": "admin",
      "method": "POST",
      "path": "/api/global_config/config/reset-default",
      "expect_status": 200,
      "body": {
        "operator_session_token": "session-token",
        "config_key": "wallet.min_recharge"
      },
      "expect_field": {
        "status": 0
      }
    },
    {
      "name": "恢复默认配置 参数非法",
      "kind": "http",
      "actor": "admin",
      "method": "POST",
      "path": "/api/global_config/config/reset-default",
      "expect_status": 200,
      "expect_field": {
        "status": 2331
      },
      "body": {}
    }
  ]
}
