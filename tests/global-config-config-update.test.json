{
  "api": "POST /api/global_config/config/update",
  "cases": [
    {
      "name": "更新配置值 成功",
      "kind": "http",
      "actor": "admin",
      "method": "POST",
      "path": "/api/global_config/config/update",
      "expect_status": 200,
      "body": {
        "operator_session_token": "session-token",
        "config_key": "wallet.min_recharge",
        "current_value": 100
      },
      "expect_field": {
        "status": 0
      }
    },
    {
      "name": "更新配置值 参数非法",
      "kind": "http",
      "actor": "admin",
      "method": "POST",
      "path": "/api/global_config/config/update",
      "expect_status": 200,
      "expect_field": {
        "status": 2321
      },
      "body": {}
    }
  ]
}
