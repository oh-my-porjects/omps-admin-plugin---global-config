{
  "method": "GET",
  "path": "/api/global_config/config/list",
  "endpoint_key": "GET /api/global_config/config/list",
  "title": "查询配置列表",
  "description": "校验查看权限后分页查询全局配置，可按模块名和关键词过滤。",
  "auth": "admin_session",
  "params": [
    {
      "name": "page",
      "type": "integer",
      "required": true,
      "constraint": "大于等于 1",
      "description": "页码。"
    },
    {
      "name": "page_size",
      "type": "integer",
      "required": true,
      "constraint": "1-100",
      "description": "每页数量。"
    },
    {
      "name": "module_name",
      "type": "string",
      "required": false,
      "constraint": "模块名格式",
      "description": "按所属模块过滤。"
    },
    {
      "name": "keyword",
      "type": "string",
      "required": false,
      "constraint": "最多 64 个字符",
      "description": "按配置键名或说明关键词过滤。"
    }
  ],
  "response": {
    "description": "返回配置列表和分页信息。",
    "data_type": "object",
    "fields": [
      {
        "name": "items",
        "type": "array",
        "description": "配置项列表。",
        "fields": [
          {
            "name": "config_key",
            "type": "string",
            "description": "配置键名。"
          },
          {
            "name": "value_type",
            "type": "string",
            "description": "值类型：string、number、boolean 或 json。"
          },
          {
            "name": "current_value",
            "type": "object",
            "description": "当前配置值，类型随 value_type 变化。",
            "fields": []
          },
          {
            "name": "default_value",
            "type": "object",
            "description": "默认配置值，类型随 value_type 变化。",
            "fields": []
          },
          {
            "name": "description",
            "type": "string",
            "description": "配置用途说明。"
          },
          {
            "name": "module_name",
            "type": "string",
            "description": "所属模块。"
          },
          {
            "name": "updated_at",
            "type": "string",
            "description": "更新时间，RFC3339 字符串。"
          }
        ]
      },
      {
        "name": "total",
        "type": "integer",
        "description": "总数量。"
      },
      {
        "name": "page",
        "type": "integer",
        "description": "当前页码。"
      },
      {
        "name": "page_size",
        "type": "integer",
        "description": "每页数量。"
      }
    ],
    "error_codes": [
      {
        "status": 2301,
        "msg": "缺少后台会话。"
      },
      {
        "status": 2302,
        "msg": "后台会话无效。"
      },
      {
        "status": 2303,
        "msg": "分页参数不合法。"
      },
      {
        "status": 2304,
        "msg": "模块或关键词参数不合法。"
      },
      {
        "status": 2305,
        "msg": "无查看权限或查询失败。"
      }
    ]
  },
  "response_example": {
    "status": 0,
    "data": {
      "items": [],
      "total": 0,
      "page": 1,
      "page_size": 20
    },
    "msg": ""
  },
  "rules": [
    {
      "category": "security",
      "title": "查询配置列表 鉴权边界",
      "body": "该接口按 auth=admin_session 执行访问控制；未满足身份、内部令牌、后台会话或 API key 要求时必须拒绝主流程。接口职责：校验查看权限后分页查询全局配置，可按模块名和关键词过滤。",
      "code_loc": "main.go:121"
    }
  ]
}
