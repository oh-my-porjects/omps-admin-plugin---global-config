{
  "method": "POST",
  "path": "/api/global_config/config/update",
  "endpoint_key": "POST /api/global_config/config/update",
  "title": "更新配置值",
  "description": "校验编辑权限后更新指定全局配置的当前值。",
  "auth": "admin_session",
  "params": [
    {
      "name": "operator_session_token",
      "type": "string",
      "required": true,
      "description": "后台操作人的会话令牌。"
    },
    {
      "name": "config_key",
      "type": "string",
      "required": true,
      "constraint": "配置键名格式",
      "description": "要更新的配置键名。"
    },
    {
      "name": "current_value",
      "type": "object",
      "required": true,
      "description": "新的配置值，类型必须匹配该配置的 value_type。",
      "fields": []
    }
  ],
  "request_example": {
    "operator_session_token": "session-token",
    "config_key": "wallet.min_recharge",
    "current_value": 100
  },
  "response": {
    "description": "返回更新后的关键字段。",
    "data_type": "object",
    "fields": [
      {
        "name": "config_key",
        "type": "string",
        "description": "配置键名。"
      },
      {
        "name": "value_type",
        "type": "string",
        "description": "值类型。"
      },
      {
        "name": "current_value",
        "type": "object",
        "description": "更新后的当前值。",
        "fields": []
      },
      {
        "name": "updated_at",
        "type": "string",
        "description": "更新时间，RFC3339 字符串。"
      }
    ],
    "error_codes": [
      {
        "status": 2321,
        "msg": "缺少后台会话。"
      },
      {
        "status": 2322,
        "msg": "后台会话无效。"
      },
      {
        "status": 2323,
        "msg": "配置键名缺失或格式不合法。"
      },
      {
        "status": 2324,
        "msg": "配置项不存在。"
      },
      {
        "status": 2325,
        "msg": "配置值缺失或与类型不匹配。"
      },
      {
        "status": 2326,
        "msg": "无编辑权限或更新失败。"
      }
    ]
  },
  "response_example": {
    "status": 0,
    "data": {
      "config_key": "wallet.min_recharge",
      "value_type": "number",
      "current_value": 100,
      "updated_at": "2026-05-28T00:00:00Z"
    },
    "msg": ""
  },
  "rules": [
    {
      "category": "security",
      "title": "更新配置值 鉴权边界",
      "body": "该接口按 auth=admin_session 执行访问控制；未满足身份、内部令牌、后台会话或 API key 要求时必须拒绝主流程。接口职责：校验编辑权限后更新指定全局配置的当前值。",
      "code_loc": "main.go:123"
    }
  ]
}
