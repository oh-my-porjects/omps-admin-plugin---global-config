  "title": "查询配置详情",
  "description": "校验查看权限后查询单个全局配置详情。",
  "auth": "admin_session",
  "params": [
    {
      "name": "config_key",
      "type": "string",
      "required": true,
      "constraint": "配置键名格式",
      "description": "要查询的配置键名。"
    }
  ],
  "response": {
    "description": "返回单个配置项详情。",
