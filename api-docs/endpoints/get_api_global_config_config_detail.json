      },
      {
        "name": "current_value",
        "type": "object",
        "description": "当前配置值。",
        "fields": []
      },
      {
        "name": "default_value",
        "type": "object",
        "description": "默认配置值。",
        "fields": []
      },
      {
        "name": "description",
